# Local prototype credentials; never use a production database here.
PGHOST=127.0.0.1
PGPORT=54329
PGUSER=ois_demo
PGPASSWORD=ois_demo_local
OPENSEARCH_URL=http://127.0.0.1:9207
API_PORT=4107
RUNTIME_DIR=.runtime

# demo uses the local prototype databases. real reads PMS and EMR and never writes to them.
SOURCE_MODE=demo
REAL_PGHOST=
REAL_PGPORT=5432
REAL_PGUSER=
REAL_PGPASSWORD=
REAL_PMS_DATABASE=RTCloudPmsDB
REAL_EMR_DATABASE=RTCloudEmrDBVNext

# Optional source-page templates. Placeholders: {sourceId} {patientId} {courseId} {prescriptionId}
# JUMP_PMS_PATIENT=http://127.0.0.1:10010/pms/patient-information?source=microApp&vPGuid={patientId}
# JUMP_EMR_DIAGNOSIS=http://127.0.0.1:10010/emr/diagnosis?source=microApp&vPGuid={patientId}
# JUMP_EMR_PLAN_REQUEST_PLAN=http://127.0.0.1:10010/emr/order-list/prescription-order?courseId={courseId}&id={sourceId}&orderType=3&source=microApp&vPGuid={patientId}
# JUMP_EMR_PLAN_REQUEST_BRACHY=http://127.0.0.1:10010/emr/order-list/prescription-order?courseId={courseId}&id={sourceId}&orderType=7&source=microApp&vPGuid={patientId}
# JUMP_EMR_PLAN_REQUEST_TBI=http://127.0.0.1:10010/emr/order-list/prescription-order?courseId={courseId}&id={sourceId}&orderType=3&source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_SIM=http://127.0.0.1:10010/emr/order-list/sim-order?courseId={courseId}&id={sourceId}&orderType=1&source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_RESET=http://127.0.0.1:10010/emr/order-list/sim-order?courseId={courseId}&id={sourceId}&orderType=1&source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_ONE_STOP=http://127.0.0.1:10010/emr/order-list/one-stop-order?courseId={courseId}&id={sourceId}&orderType=4&source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_EXAM=http://127.0.0.1:10010/emr/order-list?source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_TREATMENT=http://127.0.0.1:10010/emr/order-list/treatment-order?vPId={patientId}&trId={sourceId}&source=microApp&vPGuid={patientId}
# JUMP_EMR_DOCUMENT_CUSTOM=http://127.0.0.1:10010/emr/order-list?source=microApp&vPGuid={patientId}

# Optional local inference. Set SEARCH_MODELS=off to disable inference.
# SEARCH_BERT_PYTHON=/path/to/bert-venv/bin/python
# SEARCH_BGE_PYTHON=/path/to/bge-venv/bin/python
# SEARCH_BGE_MODEL_DIR=/path/to/bge-reranker

# Optional patient search pilot. Requires the catalog checkpoint, separate from the simulation model.
# SEARCH_PATIENT_BERT_MODEL_DIR=/path/to/patient-bert-catalog-checkpoint

# Optional local confirmed-diagnosis model.
# SEARCH_DIAGNOSIS_BERT_MODEL_DIR=/absolute/path/to/diagnosis-checkpoint

# Optional document search. Each checkpoint directory must include its own labels.json.
# SEARCH_DOCUMENT_BERT_MODEL_DIR=/absolute/path/to/ois-document-bert-v4
# SEARCH_DOCUMENT_BERT_FALLBACK_MODEL_DIR=/absolute/path/to/ois-document-fallback-bert-v4
# WEB_DIST_DIR=/absolute/path/to/built/web/dist
