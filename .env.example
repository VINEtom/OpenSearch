# Local prototype credentials; never use a production database here.
PGHOST=127.0.0.1
PGPORT=54329
PGUSER=ois_demo
PGPASSWORD=ois_demo_local
OPENSEARCH_URL=http://127.0.0.1:9207
API_PORT=4107
RUNTIME_DIR=.runtime

# demo uses the local prototype databases. real reads PMS and EMR and never writes to them.
SOURCE_MODE=demo
REAL_PGHOST=
REAL_PGPORT=5432
REAL_PGUSER=
REAL_PGPASSWORD=
REAL_PMS_DATABASE=RTCloudPmsDB
REAL_EMR_DATABASE=RTCloudEmrDBVNext

